{
  "name": "@gpt/ui",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    "./theme.css": "./src/styles/theme.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./lib/utils": {
      "@gpt/source": "./src/lib/utils.ts",
      "types": "./dist/lib/utils.d.ts",
      "import": "./dist/lib/utils.js",
      "default": "./dist/lib/utils.js"
    },
    "./lib/time": {
      "@gpt/source": "./src/lib/time.ts",
      "types": "./dist/lib/time.d.ts",
      "import": "./dist/lib/time.js",
      "default": "./dist/lib/time.js"
    },
    "./*": {
      "@gpt/source": "./src/components/ui/*.tsx",
      "types": "./dist/components/ui/*.d.ts",
      "import": "./dist/components/ui/*.js",
      "default": "./dist/components/ui/*.js"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.8.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
