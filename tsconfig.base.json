{
  "compilerOptions": {
    "composite": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@gpt/source"],
    "baseUrl": ".",
    "paths": {
      "@gpt/gpt-core": ["packages/gpt-core/src/index.ts"],
      "@gpt/alphatab-react": ["packages/alphatab-react/src/index.ts"]
    }
  }
}
