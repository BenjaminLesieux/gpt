# Copy to .env beside docker-compose.yml. Two values have no sensible
# default; everything else in the stack is derived from them.

# The domain your musicians will paste into the companion app. Its A/AAAA
# record must already point at this machine before the first `up`, because
# Caddy proves control of it over ports 80 and 443 — and a failed challenge
# counts against Let's Encrypt's weekly limit for the domain.
HUB_DOMAIN=hub.example.com

# Where certificate-expiry warnings go. A real address you read.
HUB_ACME_EMAIL=you@example.com

# Pin this to a release rather than tracking latest, so that `docker compose
# up -d` after an unattended `pull` cannot change the version under you.
# The git tag is hub-v1.2.3; the image tag it publishes is just 1.2.3, along
# with the rolling 1.2 and 1 pointers.
HUB_VERSION=latest

# Only for a fork publishing its own image.
# HUB_IMAGE=ghcr.io/you/your-repo/hub
