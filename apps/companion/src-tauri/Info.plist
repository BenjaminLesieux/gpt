<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  The state the app launches in, not the state it stays in. lib.rs also asks
	  for ActivationPolicy::Accessory, but it does so from `setup`, which runs
	  after AppKit has decided whether to show a dock icon; the bounce is brief
	  and harmless and looks like a bug. Declaring it here means the icon only
	  ever appears when `window::show_in_dock` promotes the app to Regular for
	  the extended window.
	-->
	<key>LSUIElement</key>
	<true/>
</dict>
</plist>
