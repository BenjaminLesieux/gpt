{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "es2022"],
    "types": ["node", "vite/client"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@gpt/gpt-core": ["../../packages/gpt-core/src/index.ts"],
      "@gpt/alphatab-react": ["../../packages/alphatab-react/src/index.ts"]
    }
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx"
  ],
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/locales/*.json"],
  "references": [
    {
      "path": "../../packages/gpt-core/tsconfig.lib.json"
    },
    {
      "path": "../../packages/alphatab-react/tsconfig.lib.json"
    }
  ]
}
