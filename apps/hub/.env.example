# `pnpm nx run @gpt/hub:forgejo-up` writes apps/hub/.env from this file and
# fills in FORGEJO_ADMIN_TOKEN. Copy it by hand only when pointing the hub at
# an instance you did not bring up that way.
#
# Copied as-is this file will NOT boot: FORGEJO_ADMIN_TOKEN is empty and the
# schema rejects an empty string. That is deliberate — the hub should refuse
# to start rather than fail on the first signup.

NODE_ENV=development
HOST=localhost
PORT=3000

# SQLite file. Accounts, sessions and score metadata only — never a secret,
# and never score content.
DATABASE_PATH=./hub.sqlite

# The Forgejo instance, no trailing slash. Must be >= v16.0.0: the admin
# token endpoint does not exist before it.
FORGEJO_URL=http://localhost:3001

# Site-admin personal access token with the write:admin scope. forgejo-up
# mints this through the container's CLI; in the UI it is
# Settings -> Applications -> Generate token.
FORGEJO_ADMIN_TOKEN=
