# Copy to apps/hub/.env. .env is gitignored; this file is not.
#
# Every value below has a default, so the hub boots from an empty file. The
# one that must not keep its default in production is PUBLIC_URL, and the
# schema refuses to start rather than let it.

NODE_ENV=development
HOST=localhost
PORT=3000

# Accounts, sessions, score metadata and token hashes. Never a secret and
# never score content — the repositories under GIT_ROOT hold the scores.
DATABASE_PATH=./hub.sqlite

# One bare repository per score, as <GIT_ROOT>/<account id>/<score id>.git.
# This directory is authoritative: a score row without its repository is
# broken in a way no migration fixes, so it belongs on a backed-up volume.
GIT_ROOT=./git-repos

# The origin your users reach this hub on, with no trailing slash. Clone urls
# are built from it, so behind a proxy this is the proxy's address and not
# HOST:PORT. With NODE_ENV=production the hub refuses to start while this
# still points at localhost.
PUBLIC_URL=http://localhost:3000
