# Copy to apps/hub/.env and fill in. .env is gitignored; this file is not.
#
# Copied as-is this file will NOT boot: FORGEJO_ADMIN_TOKEN is empty and the
# schema rejects an empty string. That is deliberate — the hub should refuse
# to start rather than fail on the first signup. Until M1 stands up a real
# instance, any non-empty placeholder is enough: nothing calls Forgejo yet.

NODE_ENV=development
HOST=localhost
PORT=3000

# SQLite file. Accounts, sessions and score metadata only — never a secret,
# and never score content.
DATABASE_PATH=./hub.sqlite

# The Forgejo instance, no trailing slash. Must be >= v16.0.0: the admin
# token endpoint does not exist before it.
FORGEJO_URL=http://localhost:3001

# Site-admin personal access token with the write:admin scope. Nothing
# bootstraps this — create it by hand, once, in the Forgejo UI.
FORGEJO_ADMIN_TOKEN=
